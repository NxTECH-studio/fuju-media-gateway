PORT=8080

# Comma-separated bearer tokens accepted by POST /icons.
# TODO: replace with the NxTECH auth platform once available.
API_KEYS=

# Comma-separated origins allowed by CORS. Empty = block all browser calls (backend-only).
ALLOWED_ORIGINS=

# R2 (S3-compatible) credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
